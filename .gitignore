# Hugo build output (deployed via Actions, not from repo)
public/
.hugo_build.lock

# OS / editor noise
.DS_Store
*.swp
*~

# MCP / agent session artifacts (local-only; do not commit)
.mcp.json
.playwright-mcp/
logs/
__pycache__/

# Built product binaries (published separately to Gumroad)
dist/

# Video pipeline artifacts (rendered locally, published via GitHub Releases)
scripts/video/build/
scripts/video/.venv-tts/

# Playwright traces + failure screenshots from scripts/browser (local evidence, not source)
scripts/browser/runs/

# Queued video assets are linked/copied from the build dir, never committed
marketing/publish-queue/**/*.mp4

# Advisory lock sidecar written by scripts/ledger.py (local only, never source)
decisions/decisions.jsonl.lock
